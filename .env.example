POSPAL_USERNAME=your-pospal-username
POSPAL_PASSWORD=your-pospal-password
MYJ_ADMIN_USERNAME=your-myj-admin-username
MYJ_ADMIN_PASSWORD=your-myj-admin-password

# Optional. Defaults are usually correct.
POSPAL_PRODUCT_URL=https://beta9.pospal.cn/Product/Manage
MYJ_PRODUCTS_URL=https://admin.myj.info/products
TIMEZONE=Asia/Shanghai

# Safety thresholds. Tune only after checking normal daily volumes.
POSPAL_EXPORT_MIN_ROWS=1000
MYJ_IMPORT_MIN_SUCCESS_COUNT=1000
MYJ_IMPORT_WARNING_REVIEW_THRESHOLD=20

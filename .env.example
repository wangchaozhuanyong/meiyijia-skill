POSPAL_USERNAME=your-pospal-username
POSPAL_PASSWORD=your-pospal-password
MYJ_ADMIN_USERNAME=your-myj-admin-username
MYJ_ADMIN_PASSWORD=your-myj-admin-password

# Optional. Defaults are usually correct.
POSPAL_PRODUCT_URL=https://beta9.pospal.cn/Product/Manage
MYJ_PRODUCTS_URL=https://admin.myj.info/products
# Business marker timezone for completion files and success summaries.
# The launchd installer separately schedules the real update at America/Los_Angeles 12:00 PM.
TIMEZONE=Asia/Shanghai

# Safety thresholds. Tune only after checking normal daily volumes.
POSPAL_EXPORT_MIN_ROWS=1000
MYJ_IMPORT_MIN_SUCCESS_COUNT=1000
MYJ_IMPORT_WARNING_REVIEW_THRESHOLD=20

# Delete current-run downloads, screenshots, logs, reports, and warning files after a successful real import.
# Failed or unclear runs keep artifacts for troubleshooting.
CLEANUP_SUCCESS_ARTIFACTS=true
# GitHub Actions recovery input; normally populated by workflow_dispatch.
# Optional link to the report Issue comment containing verified reconciliation.
RECONCILIATION_EVIDENCE_URL=
